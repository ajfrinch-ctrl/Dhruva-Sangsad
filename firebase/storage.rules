rules_version = '2';
/* ধ্রুব সংসদ — Firebase Storage rules
   Unauthenticated read/write is denied. Uploads are limited to 10 MB and
   JPEG / PNG / WebP / PDF. A user may only create objects under their own
   uploads/{uid}/ prefix. Storage rules cannot read Realtime Database roles,
   so delete is allowed for any authenticated user; the app still hides the
   Delete button from unauthorized accounts and filesData rules restrict
   metadata. */
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf');

      /* Authenticated delete — RTDB role cannot be queried from Storage rules.
         App-level canDeleteFile() + filesData write rules are the authorization layer. */
      allow delete: if request.auth != null;
    }
  }
}
